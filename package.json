{
  "name": "picasso",
  "version": "0.0.9",
  "description": "Gerador de carteirinhas estudantis para a rede estadual do RJ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "server": "node server.js",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.picasso.app",
    "productName": "Picasso",
    "icon": "assets/icon.ico",
    "publish": [
      {
        "provider": "github",
        "releaseType": "prerelease"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "pt_BR"
      ]
    }
  },
  "keywords": [
    "carteirinha",
    "escola",
    "scraping",
    "electron",
    "educacao"
  ],
  "author": "normaii",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  }
}
