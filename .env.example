# ==============================================================
# Picasso — Configuração do Ambiente
# ==============================================================
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo .env — ele contém dados sensíveis.
# ==============================================================

# Caminho da pasta onde os dados serão salvos (fotos, banco, PDFs).
# Pode apontar para uma pasta do Google Drive para backup automático.
# Exemplo Windows: C:\Users\SeuNome\Google Drive\Picasso
# Exemplo Mac/Linux: /home/seuusuario/GoogleDrive/Picasso
DATA_DIR=./data

# URL base do sistema Conexão Educação (não altere a menos que mude).
SYSTEM_URL=https://conexao.educacao.rj.gov.br

# Porta do servidor local (padrão: 3000).
PORT=3000
